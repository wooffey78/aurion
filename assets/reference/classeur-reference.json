{
  "version": "15.4.65",
  "workbook": "assets/reference/AURION-classeur-calculs.xlsx",
  "mapping": [
    {
      "aurion": "computePricing().baseRevenueHt",
      "excel": "Moteur document!B17",
      "formule": "TTC ÷ (1 + TVA/100), arrondi au centime (half-up)"
    },
    {
      "aurion": "computePricing().totalHt",
      "excel": "Moteur document!B21",
      "formule": "base HT + kilométrage facturé (client_price uniquement)"
    },
    {
      "aurion": "computePricing().directCostsHt",
      "excel": "Moteur document!B22",
      "formule": "pièces × qté + livraison + consommables + km interne + main-d’œuvre interne"
    },
    {
      "aurion": "computePricing().grossMargin",
      "excel": "Moteur document!B23",
      "formule": "total HT − coûts directs"
    },
    {
      "aurion": "computePricing().contributionsTotal",
      "excel": "Moteur document!B24",
      "formule": "Σ taux × base HT (chaque cotisation sur son assiette)"
    },
    {
      "aurion": "computePricing().netResult",
      "excel": "Moteur document!B25",
      "formule": "marge brute − cotisations"
    },
    {
      "aurion": "computePricing().totalTtc",
      "excel": "Moteur document!B26",
      "formule": "TTC cible + km facturé TTC"
    },
    {
      "aurion": "computePricing().vat",
      "excel": "Moteur document!B27",
      "formule": "total TTC − total HT"
    },
    {
      "aurion": "Encaissements HT (comptabilité)",
      "excel": "Encaissements & TVA!C",
      "formule": "Σ paiements TTC ÷ (1+TVA), paiements détaillés ∪ factures payées"
    },
    {
      "aurion": "Prévisionnel — volume et projections HT",
      "excel": "Prévisionnel!A:G",
      "formule": "volume = (factures + devis récents)/6 ; entrées HT = volume × ticket HT × horizon"
    }
  ],
  "cases": [
