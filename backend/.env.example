# Copiez ce fichier vers backend/.env pour le développement local uniquement.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://aurion_test:aurion_test_local_only@localhost:54329/aurion_test
JWT_ISSUER=aurion
JWT_AUDIENCE=aurion-web
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:4000
CORS_ORIGIN=http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:5500,http://localhost:5500
AURION_ENCRYPTION_KEY=replace-with-a-dedicated-key-of-at-least-32-characters
AURION_ENCRYPTION_KEY_VERSION=k1
AURION_ENCRYPTION_KEY_PREVIOUS=
AURION_ENCRYPTION_KEY_PREVIOUS_VERSION=
AURION_ENCRYPTION_LEGACY_JWT_KEY=false
AURION_SUPPORT_EMAIL=support@example.invalid
BILLING_VAT_RATE_BPS=0
PLATFORM_SMTP_HOST=smtp-relay.brevo.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURITY=starttls
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM=
AURION_STORAGE_BACKEND=local
AURION_S3_ENDPOINT=https://s3.de.io.cloud.ovh.net
AURION_S3_REGION=de
AURION_S3_BUCKET=
AURION_S3_ACCESS_KEY=
AURION_S3_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary
# IA locale par défaut pour l’installation Windows. Le setup peut installer Ollama et télécharger Qwen après confirmation.
AURION_AI_PROVIDER=local
AURION_OLLAMA_URL=http://127.0.0.1:11434
AURION_LOCAL_LLM_MODEL=qwen3.5:4b-q4_K_M
# Allows account creation only on a non-production local evaluation install; never publishes legal drafts or enables payment.
AURION_LOCAL_EVALUATION_MODE=true
# Fournisseurs gérés facultatifs ; ignorés lorsque AURION_AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# À définir seulement pour la commande de migration et jamais dans le serveur web :
# AURION_MIGRATION_DATABASE_URL=postgresql://... (rôle de migration avec droits DDL)

# Active seulement pendant la première migration du service historique Render vers OVH S3.
AURION_AUTO_MIGRATE_LOCAL_STORAGE=false
