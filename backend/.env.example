# Copy to backend/.env for local development; never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://aurion:CHANGE_ME@127.0.0.1:5432/aurion
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGIN=http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:5500,http://localhost:5500
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:4000
AURION_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_RANDOM_SECRET

# Optional integrations (configure only when used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=465
PLATFORM_SMTP_SECURITY=ssl
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM=
