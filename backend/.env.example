# Copiez ce fichier vers backend/.env pour le développement local uniquement.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://aurion_test:aurion_test_local_only@localhost:54329/aurion_test
# RLS 074 : pool d'administration inter-entreprises (console admin, travaux planifiés, webhook Stripe).
# Rôle SQL membre de « aurion_admin » (créé par la migration 074) : voir docs/SECURITE-RLS.md.
# Sans cette URL : isolation active, mais console d'administration et travaux planifiés refusent (503).
AURION_ADMIN_DATABASE_URL=
JWT_ISSUER=aurion
JWT_AUDIENCE=aurion-web
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:4000
CORS_ORIGIN=http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:5500,http://localhost:5500
AURION_ENCRYPTION_KEY=replace-with-a-dedicated-key-of-at-least-32-characters
AURION_ENCRYPTION_KEY_VERSION=k1
AURION_ENCRYPTION_KEY_PREVIOUS=
AURION_ENCRYPTION_KEY_PREVIOUS_VERSION=
AURION_ENCRYPTION_LEGACY_JWT_KEY=false
AURION_SUPPORT_EMAIL=support@example.invalid
BILLING_VAT_RATE_BPS=0
# SMTP plateforme (accusés de réception, réinitialisation de mot de passe) : hôte et port de votre fournisseur.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURITY=starttls
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM=
AURION_STORAGE_BACKEND=local
AURION_S3_ENDPOINT=https://s3.de.io.cloud.ovh.net
AURION_S3_REGION=de
AURION_S3_BUCKET=
AURION_S3_ACCESS_KEY=
AURION_S3_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Bloc 3 — réception des factures fournisseurs via la plateforme agréée (PA) choisie par
# l'entrepreneur (voir docs/PLATEFORME-AGREEE.md). AURION_PA_PROVIDER = identifiant de
# l'adaptateur (contrat générique signé : « generic »). Sans provider : réception refusée (503).
# Le secret signe les webhooks entrants (HMAC-SHA256) ; jamais journalisé ; ≥ 32 caractères.
AURION_PA_PROVIDER=
AURION_PA_WEBHOOK_SECRET=
AURION_PA_MAX_FILE_BYTES=10485760
# Bloc 4 — émission : délai d'attente d'un accusé d'émission (ms ; 15000 par défaut).
AURION_PA_OUT_TIMEOUT_MS=15000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary
# Pré-vol Google uniquement (jamais lu par l'application) : jeton de rafraîchissement d'un compte
# de test avec les scopes gmail.send + calendar. Pour le quota Drive, utiliser le même jeton s'il
# porte drive.file, ou fournir GOOGLE_PREFLIGHT_DRIVE_REFRESH_TOKEN. Ne jamais committer ces valeurs.
GOOGLE_PREFLIGHT_REFRESH_TOKEN=
GOOGLE_PREFLIGHT_DRIVE_REFRESH_TOKEN=
# Stockage documentaire cloud (Google Drive, autorisation drive.file) : URI de retour distincte, à déclarer dans Google Cloud.
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:4000/cloud/google/callback
# Auth0 — connexion SSO (Regular Web Application, Authorization Code + PKCE).
# L'adresse e-mail Auth0 doit être vérifiée et correspondre à un compte Aurion existant.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://127.0.0.1:4000/auth/auth0/callback
# Seuils d'alerte de quota (avertissement, alerte, critique, saturé) en pourcentage.
AURION_CLOUD_QUOTA_THRESHOLDS=80,90,95,100
# Allows account creation only on a non-production local evaluation install; never publishes legal drafts or enables payment.
AURION_LOCAL_EVALUATION_MODE=true
# À définir seulement pour la commande de migration et jamais dans le serveur web :
# AURION_MIGRATION_DATABASE_URL=postgresql://... (rôle de migration avec droits DDL)

# Active seulement pendant la première migration du service historique Render vers OVH S3.
AURION_AUTO_MIGRATE_LOCAL_STORAGE=false

# ---------------------------------------------------------------- documents juridiques (version 5.1)
# L'application marque les documents juridiques « brouillon » tant que (a) l'approbation de
# version n'est pas explicite, (b) une variable obligatoire manque, ou (c) un texte contient
# encore un placeholder non résolu (« [À compléter…], [À renseigner…], NE PAS PUBLIER… »).
# Publication = AURION_LEGAL_PUBLICATION_APPROVAL=5.1 + variables ci-dessous complètes +
# textes docs/ propres. Valeurs pré-remplies d'après les déclarations de l'éditeur (à
# confirmer sur justificatifs officiels avant ouverture commerciale).
AURION_LEGAL_PUBLICATION_APPROVAL=
AURION_LEGAL_PUBLISHER_NAME=Coulibaly Damien
AURION_LEGAL_PUBLISHER_FORM=entrepreneur individuel — régime micro-entreprise
AURION_LEGAL_PUBLISHER_SIREN=888485695
AURION_LEGAL_PUBLISHER_SIRET=88848569500033
AURION_LEGAL_PUBLISHER_ADDRESS=5 Rue Jacques Prevert, 85300 Challans, France
AURION_LEGAL_PUBLISHER_VAT=TVA non applicable — article 293 B du CGI
AURION_LEGAL_DIRECTOR=Coulibaly Damien
AURION_LEGAL_PUBLISHER_EMAIL=easyfixit.reparation@gmail.com
AURION_PRIVACY_CONTACT_EMAIL=easyfixit.reparation@gmail.com
AURION_ACCESSIBILITY_CONTACT_EMAIL=easyfixit.reparation@gmail.com
AURION_ACCESSIBILITY_AUDIT_DATE=
AURION_ACCESSIBILITY_AUDIT_RESULT=
# Hébergeur contractuel : coordonnées reprises du contrat après souscription.
AURION_HOST_NAME=
AURION_HOST_ADDRESS=
AURION_HOST_CONTACT=
AURION_SUBPROCESSORS=Render (hébergement, Francfort), PostgreSQL gérée (UE), OVHcloud Object Storage de/Francfort, Brevo (SMTP), Stripe (abonnement)

# Amorçage administrateur : autorisé uniquement hors production (NODE_ENV≠production).
# En production, créer explicitement le premier administrateur : npm run admin:create -- email@exemple.fr
# Mettre false pour désactiver aussi l'amorçage sur une installation locale.
AURION_ADMIN_BOOTSTRAP=true

# 15.4.51 — supervision (PROMPT A4/A6) : e-mail d'exploitation recevant le résumé quotidien
# des lettres mortes de l'outbox (vide = alerte désactivée) et chemin du journal de sauvegarde
# écrit par scripts/backup-nightly.mjs (exposé dans /health : lastBackupAt).
AURION_OPS_ALERT_EMAIL=
AURION_BACKUP_LOG_PATH=
