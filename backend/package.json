{
  "name": "aurion-backend",
  "version": "15.2.33",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/migrate.js && node scripts/start-server.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "db:migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "db:tool": "node dist/dbtool.js",
    "db:reset:test": "node scripts/reset-test-data.mjs",
    "admin:create": "tsx src/create-admin.ts",
    "db:test:up": "docker compose -f ../docker-compose.test.yml up -d postgres",
    "db:test:down": "docker compose -f ../docker-compose.test.yml down -v",
    "test:integration": "npm run db:test:up && npm test; npm run db:test:down"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.0",
    "@fastify/helmet": "13.0.0",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.2.0",
    "@fastify/sensible": "6.0.3",
    "@fastify/static": "10.1.7",
    "adm-zip": "0.6.1",
    "argon2": "0.43.0",
    "docx": "9.5.1",
    "dotenv": "17.2.3",
    "fastify": "5.6.1",
    "fastify-plugin": "5.1.0",
    "jose": "6.1.0",
    "nodemailer": "7.0.10",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "stripe": "19.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "24.8.1",
    "@types/nodemailer": "7.0.2",
    "@types/pdfkit": "0.13.9",
    "@types/pg": "8.15.5",
    "@types/smtp-server": "3.5.0",
    "smtp-server": "3.15.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
