{
  "name": "aurion-backend",
  "version": "15.4.41",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/migrate.js && node scripts/start-server.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "db:migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "db:tool": "node dist/dbtool.js",
    "db:reset:test": "node scripts/reset-test-data.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore:drill": "node scripts/restore-db.mjs",
    "check:integrations": "node scripts/check-integrations.mjs",
    "check:legal": "node scripts/check-legal-readiness.mjs",
    "admin:create": "tsx src/create-admin.ts",
    "db:test:up": "docker compose -f ../docker-compose.test.yml up -d postgres",
    "db:test:down": "docker compose -f ../docker-compose.test.yml down -v",
    "secrets:rotate": "npm run build && node scripts/rotate-secrets.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.2.0",
    "@fastify/sensible": "6.0.8",
    "@fastify/static": "10.1.12",
    "adm-zip": "0.6.1",
    "argon2": "0.45.2",
    "docx": "9.15.4",
    "dotenv": "16.6.1",
    "fast-xml-parser": "5.12.1",
    "fastify": "5.12.8",
    "fastify-plugin": "5.0.1",
    "google-auth-library": "10.9.1",
    "googleapis": "160.0.0",
    "jose": "6.2.17",
    "light-my-request": "6.8.1",
    "nodemailer": "10.6.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "24.3.0",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "playwright": "^1.65.1",
    "smtp-server": "3.21.6",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  },
  "allowScripts": {
    "argon2@0.43.0": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "gaxios": "^7.1.4"
  }
}
