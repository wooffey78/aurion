{
  "name": "aurion-backend",
  "version": "15.2.31",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "db:migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "db:tool": "node dist/dbtool.js",
    "db:reset:test": "powershell -ExecutionPolicy Bypass -File scripts/reset-test-data.ps1",
    "admin:create": "tsx src/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.0",
    "@fastify/helmet": "13.0.0",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.2.0",
    "@fastify/sensible": "6.0.3",
    "@fastify/static": "8.2.0",
    "adm-zip": "0.5.16",
    "argon2": "0.43.0",
    "docx": "9.5.1",
    "dotenv": "16.6.1",
    "fastify": "5.4.0",
    "fastify-plugin": "5.0.1",
    "googleapis": "160.0.0",
    "jose": "6.0.10",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "zod": "4.1.5",
    "nodemailer": "7.0.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "tsx": "4.19.4",
    "typescript": "5.9.2",
    "@types/pdfkit": "0.13.9",
    "@types/nodemailer": "6.4.17",
    "smtp-server": "3.14.0",
    "@types/smtp-server": "3.5.10"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
