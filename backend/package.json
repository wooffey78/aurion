{
  "name": "aurion-backend",
  "version": "15.3.18",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/migrate.js && node scripts/start-server.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "db:migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "db:tool": "node dist/dbtool.js",
    "db:reset:test": "node scripts/reset-test-data.mjs",
    "admin:create": "tsx src/create-admin.ts",
    "db:test:up": "docker compose -f ../docker-compose.test.yml up -d postgres",
    "db:test:down": "docker compose -f ../docker-compose.test.yml down -v",
    "secrets:rotate": "npm run build && node scripts/rotate-secrets.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.0",
    "@fastify/helmet": "13.0.0",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.2.0",
    "@fastify/sensible": "6.0.3",
    "@fastify/static": "10.1.7",
    "adm-zip": "0.6.1",
    "argon2": "0.43.0",
    "docx": "9.5.1",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "fastify-plugin": "5.0.1",
    "googleapis": "160.0.0",
    "jose": "6.0.10",
    "nodemailer": "10.2.1",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "zod": "4.6.7",
    "google-auth-library": "10.9.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "24.3.0",
    "@types/pdfkit": "0.13.9",
    "@types/pg": "8.15.5",
    "@types/smtp-server": "3.5.10",
    "smtp-server": "3.21.1",
    "tsx": "4.19.4",
    "typescript": "5.9.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
